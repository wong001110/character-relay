CHARACTER_RELAY_ENVIRONMENT=development
CHARACTER_RELAY_DEBUG=false
CHARACTER_RELAY_LOG_LEVEL=INFO
CHARACTER_RELAY_DATABASE_URL=sqlite:///./echo_masque.db
CHARACTER_RELAY_PROVIDER_TRACE_MODE=summary
CHARACTER_RELAY_PROVIDER_TRACE_MAX_CHARS=4000
CHARACTER_RELAY_PROVIDER_TRACE_RETENTION_DAYS=7
CHARACTER_RELAY_PROVIDER_TRACE_MAX_RECORDS=2000

# Single cumulative LangGraph rollout mode:
# off -> condition_watch -> character_turn -> social_turn
CHARACTER_RELAY_LANGGRAPH_MODE=off

# Browser Capability for web.search, image.search, places.search and rendered fetch fallback.
# Chromium is lazy-launched and automatically shut down after the configured idle window.
CHARACTER_RELAY_BROWSER_TOOLS_ENABLED=true
CHARACTER_RELAY_BROWSER_PAGE_IDLE_SECONDS=180
CHARACTER_RELAY_BROWSER_CONTEXT_IDLE_SECONDS=300
CHARACTER_RELAY_BROWSER_IDLE_SECONDS=600
CHARACTER_RELAY_BROWSER_MAX_LIFETIME_SECONDS=3600
CHARACTER_RELAY_BROWSER_MAX_OPERATIONS=100
CHARACTER_RELAY_BROWSER_MAX_CONCURRENT_CONTEXTS=3
CHARACTER_RELAY_BROWSER_NAVIGATION_TIMEOUT_MS=15000

# V1.2 scheduled reminder delivery.
CHARACTER_RELAY_SCHEDULER_POLL_SECONDS=5
CHARACTER_RELAY_SCHEDULER_RETRY_SECONDS=30
CHARACTER_RELAY_SCHEDULER_MAX_ATTEMPTS=3

# V2 persisted condition watches. Individual watches cannot check more frequently than 5 min;
# this only controls how often Runtime looks for watches whose next_check_at is already due.
CHARACTER_RELAY_CONDITION_WATCH_POLL_SECONDS=60

# Use the same environment variable name and token value in both the Character Relay API
# service and the Discord Connector service. In Railway this can be a shared/project variable.
# It powers Discord message search, polls, attachment inspection, and Bot-mode reminder delivery.
DISCORD_BOT_TOKEN=
