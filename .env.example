ECHO_MASQUE_ENVIRONMENT=development
ECHO_MASQUE_DEBUG=false
ECHO_MASQUE_LOG_LEVEL=INFO
ECHO_MASQUE_DATABASE_URL=sqlite:///./echo_masque.db
ECHO_MASQUE_PROVIDER_TRACE_MODE=summary
ECHO_MASQUE_PROVIDER_TRACE_MAX_CHARS=4000
ECHO_MASQUE_PROVIDER_TRACE_RETENTION_DAYS=7
ECHO_MASQUE_PROVIDER_TRACE_MAX_RECORDS=2000

# Browser Capability for web.search, image.search, places.search and rendered fetch fallback.
# Chromium is lazy-launched and automatically shut down after the configured idle window.
ECHO_MASQUE_BROWSER_TOOLS_ENABLED=true
ECHO_MASQUE_BROWSER_PAGE_IDLE_SECONDS=180
ECHO_MASQUE_BROWSER_CONTEXT_IDLE_SECONDS=300
ECHO_MASQUE_BROWSER_IDLE_SECONDS=600
ECHO_MASQUE_BROWSER_MAX_LIFETIME_SECONDS=3600
ECHO_MASQUE_BROWSER_MAX_OPERATIONS=100
ECHO_MASQUE_BROWSER_MAX_CONCURRENT_CONTEXTS=3
ECHO_MASQUE_BROWSER_NAVIGATION_TIMEOUT_MS=15000

# V1.2 scheduled reminder delivery.
ECHO_MASQUE_SCHEDULER_POLL_SECONDS=5
ECHO_MASQUE_SCHEDULER_RETRY_SECONDS=30
ECHO_MASQUE_SCHEDULER_MAX_ATTEMPTS=3

# Use the same environment variable name and token value in both the Character Relay API
# service and the Discord Connector service. In Railway this can be a shared/project variable.
# It powers Discord message search, polls, attachment inspection, and Bot-mode reminder delivery.
DISCORD_BOT_TOKEN=
