ECHO_MASQUE_ENVIRONMENT=development
ECHO_MASQUE_DEBUG=false
ECHO_MASQUE_LOG_LEVEL=INFO
ECHO_MASQUE_DATABASE_URL=sqlite:///./echo_masque.db
ECHO_MASQUE_PROVIDER_TRACE_MODE=summary
ECHO_MASQUE_PROVIDER_TRACE_MAX_CHARS=4000
ECHO_MASQUE_PROVIDER_TRACE_RETENTION_DAYS=7
ECHO_MASQUE_PROVIDER_TRACE_MAX_RECORDS=2000

# Tool Calling providers. These stay server-side and are never exposed to Character prompts.
# Brave powers web.search and image.search.
ECHO_MASQUE_BRAVE_SEARCH_API_KEY=
# For discord.search_messages and discord.create_poll, inject the same managed Bot token
# into the API service that the Discord Connector uses as DISCORD_BOT_TOKEN.
ECHO_MASQUE_DISCORD_TOOL_BOT_TOKEN=
