new file mode 100644
index 0000000..c49adc8
--- /dev/null
+++ b/src/echo_masque/persistence/conversation_episode_repository.py
@@ -0,0 +1,145 @@
+"""Persistence for derived Episode projections."""
+
+from __future__ import annotations
+
