DISCORD_BOT_TOKEN=
CHARACTER_RELAY_API_URL=https://your-character-relay-api.up.railway.app
CHARACTER_RELAY_CONNECTOR_TOKEN=
CHARACTER_RELAY_CONNECTION_ID=
PORT=3000
DEPLOYMENT_REFRESH_SECONDS=30
HEARTBEAT_SECONDS=30
MAX_CONTEXT_MESSAGES=20
# Safe default: set true only after enabling Message Content Intent in Discord.
# Character Relay's normal reply/context flow requires true.
DISCORD_MESSAGE_CONTENT_INTENT=false
DISCORD_AMBIENT_PARTICIPATION_ENABLED=false
DISCORD_ROOM_BUFFER_ENABLED=true
DISCORD_ROOM_BUFFER_QUIET_MS=3000
DISCORD_ROOM_BUFFER_MAX_WAIT_MS=10000
DISCORD_ROOM_BUFFER_MAX_MESSAGES=5
DISCORD_ROOM_BUFFER_MAX_CHARACTERS=1500
DISCORD_GROUP_ADDRESS_ALIASES=
DISCORD_BOT_CONTINUATION_ENABLED=true
DISCORD_CONVERSATION_MAX_DEPTH=4
DISCORD_CONVERSATION_MAX_RESPONSES=8
# The API permits 300-second turn jobs by default; leave room to drain progress.
DISCORD_TURN_JOB_MAX_WAIT_MS=330000
DISCORD_TURN_JOB_RECOVERY_MAX_CONCURRENT=4
